# RAG demo 环境配置模板
# 用法：cp .env.example .env 后按需修改（.env 不入库）

# 远程 Ollama LLM 服务
OLLAMA_URL=http://192.168.123.71:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
# LLM 响应较慢（80~135s），读超时建议 ≥ 300
OLLAMA_READ_TIMEOUT_SECONDS=300

# 可选：Milvus / embedding / 切片参数（不配则用 app/config.py 默认值）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION_NAME=knowledge_base
# BGE_MODEL_NAME=BAAI/bge-m3
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100

# 必配：注入 rag-demo 到 sys.path（sitecustomize.py 读取）
PYTHONPATH=/home/bosiju/code_workspace/rag_learn/rag-demo
